package projects;
import java.util.Scanner;

public class GuessNumber {

	static Scanner console = new Scanner(System.in);
	
	public static void main(String[] args) {
			
		boolean start = true;
		int max = 100;
		int rand = (int) (1 + max * Math.random());
		int guess, count = 0;
		
		do {
			
			System.out.println("1- Start");
			System.out.println("2- Change maximum number (" + max + ")");
			System.out.println("3- Exit");
			System.out.print("Chose an option: ");
			
			int choice = console.nextInt();
			
			switch (choice) {
				case 1:
					start = true;
					break;
				case 2:
					System.out.print("Enter the maximum number: ");
					max = console.nextInt();
					break;
			}
			
			if (choice == 3) {
				start = false;
				break;
			}
			
			
			rand = (int) (1 + max * Math.random());
			count = 0;
			boolean viewed = false;
			
			do {
				System.out.print("Guess the number (-1 to view number): ");
				guess = console.nextInt();
				if (guess == -1) {
					System.out.println("The number was " + rand);
					viewed = true;
					break;
				}
				count++;
				int range = guess - rand;
				int quarter = rand / 4;
				int lowInt = rand / 20;
				
				if (range >= quarter) System.out.println("Too high");
				else if (range < quarter && range > lowInt) System.out.println("High");
				else if (range <= lowInt && range > 0) System.out.println("Close but high");
				
				if (range < 0) {
					int absRange = Math.abs(range);
					if (absRange >= quarter) System.out.println("Too low");
					else if (absRange < quarter && absRange > lowInt) System.out.println("Low");
					else if (absRange <= lowInt && absRange > 0) System.out.println("Close but low");
				}
			} while (guess != rand);
				if (start && viewed == false) System.out.println
				("You guessed the number " + rand + " in " + count + " times!");
		} while (start);
		
		console.close();
		
	}

}
